{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "vim",
  "autoMemoryEnabled": false,
  "autoCompactEnabled": false,
  "idleCompaction": false,
  "skipAutoPermissionPrompt": true
}
